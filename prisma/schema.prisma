generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AnimationProject {
  id          String                @id @default(cuid())
  ownerId     String
  owner       User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String?
  status      String
  stylePreset String?
  aspectRatio String?
  /** basic | standard | pro — enforced server-side */
  presetId             String   @default("standard")
  /** Vidu model id used for transitions (from preset at create time). */
  viduModel            String?
  viduResolution       String?
  viduDurationSeconds  Int?
  /** Estimated credits for this project at creation (UI / planning only). */
  estimatedCredits     Int?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  images      AnimationImage[]
  transitions AnimationTransition[]
  exports     AnimationExport[]
  usageLedger AnimationUsageLedger[]

  @@index([ownerId, createdAt])
}

model AnimationImage {
  id         String           @id @default(cuid())
  projectId  String
  project    AnimationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order      Int
  fileName   String
  mimeType   String?
  sizeBytes  Int?
  storageKey String?
  previewUrl String?
  createdAt  DateTime         @default(now())

  @@index([projectId, order])
}

model AnimationTransition {
  id            String           @id @default(cuid())
  projectId     String
  project       AnimationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  startImageId  String
  endImageId    String
  order         Int
  status        String
  provider      String?
  providerJobId String?
  outputVideoUrl String?
  errorMessage  String?
  progress      Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([projectId, order])
  @@index([projectId, status])
}

model AnimationExport {
  id            String           @id @default(cuid())
  projectId     String
  project       AnimationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status        String
  outputVideoUrl String?
  errorMessage  String?
  progress      Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([projectId, status])
}

model User {
  id           String                 @id @default(cuid())
  email        String                 @unique
  passwordHash String
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  animationProjects AnimationProject[]
  animationUsage    AnimationUsageLedger[]
}

model AnimationUsageLedger {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId        String?  @unique
  project          AnimationProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  presetId         String
  estimatedCredits Int
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, presetId, createdAt])
}
