generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AnimationProject {
  id          String                @id @default(cuid())
  ownerId     String
  owner       User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String?
  status      String
  /** classic (default) | instant_premium */
  projectType String                @default("classic")
  /** Target merged length for instant_premium; derived from image count × transition seconds. */
  instantOutputDurationSeconds Int?
  /** Story Mode: sum of all scene card durations (overlay pacing plan); may exceed instantOutputDurationSeconds. */
  instantStoryboardDurationSeconds Int?
  /** transition = pairwise Vidu segments; story = single Vidu multiframe video. */
  instantMode String @default("transition")
  /** Per-transition / per-multiframe-segment duration: 3, 5, or 8 (UI: Fast / Standard / Cinematic). */
  instantTransitionSeconds Int @default(5)
  /** Story mode scene copy for post-Vidu ASS overlay (JSON InstantSceneText[]). */
  instantSceneTexts Json?
  /** string[] chip ids for instant_premium */
  instantSelectedChips Json?
  instantUserIntent   String?
  /** Locked overlay text layers (JSON LockedTextLayer[]). Rendered after Vidu, not by the model. */
  instantLockedTextLayers Json?
  /** Canonical language-export layers (JSON LanguageTextLayersSnapshot). */
  languageTextLayersJson Json?
  /** When true, Vidu prompts include text-safety rules and finals get deterministic text overlays. */
  instantLockedTextMode Boolean @default(true)
  /** poster_motion_preserve | deevid_text_safe | hybrid_overlay | exact_freeze | none */
  instantTextRenderMode String @default("poster_motion_preserve")
  /** DeeVid poster animation toggles (JSON PosterMotionSettings). */
  instantPosterMotionSettings Json?
  /** exact | cinematic | social-ui | floating | soft-glow | kinetic */
  instantHybridOverlayStyle String @default("cinematic")
  /** OCR-enriched text blocks for hybrid reprojection (JSON ProjectDetectedTextSnapshot). */
  instantDetectedTextMetadata Json?
  /** Last sanitized overlay error (e.g. missing drawtext); safe for UI. */
  lastOverlayError String?
  /** overlay_failed | merge_failed when status is failed_overlay or failed */
  failureReason String?
  /** Worker job tracking when VIDEO_RENDER_MODE=worker */
  instantWorkerJobStartedAt DateTime?
  /** queued | running | completed | failed */
  instantWorkerJobStatus String?
  /** Incremented after each successful final-video rebuild (merge-only). */
  instantFinalRebuildCount Int @default(0)
  instantFinalRebuiltAt DateTime?
  /** Last successful final URL before the most recent rebuild. */
  instantPreviousFinalVideoUrl String?
  /** Optional notes per text rerender generation (JSON TextVersionNoteEntry[]). */
  instantTextVersionNotesJson Json?
  /** Pre-overlay merged Vidu video (concat only, no ASS/locked text). */
  instantCleanFinalVideoUrl String?
  /** running | failed — null when idle */
  instantFinalRebuildStatus String?
  /** Non-billable rebuild audit events (JSON). */
  instantFinalRebuildAuditJson Json?
  stylePreset String?
  aspectRatio String?
  /** basic | standard | pro | smooth — enforced server-side */
  presetId             String   @default("standard")
  /** Vidu model id used for transitions (from preset at create time). */
  viduModel            String?
  viduResolution       String?
  viduDurationSeconds  Int?
  /** Estimated credits for this project at creation (UI / planning only). */
  estimatedCredits     Int?
  /** True when admin (or future power) used advanced overrides vs preset-only Vidu fields. */
  advancedSettingsEnabled Boolean @default(false)
  /** Optional user hint; combined server-side with preset prompt for Vidu. */
  userPrompt           String?
  /** morph | cinematic | product | dynamic — guides combined prompt; defaults to cinematic when null. */
  intent               String?
  /** Shared continuity framing for every transition; null on legacy rows uses server default. */
  globalPromptContext  String?
  /** Sanitized Studio → Motion handoff payload (metadata only, no binaries). */
  studioHandoffJson            Json?
  /** Studio QA intelligence snapshot + image lineage fingerprint. */
  studioIntelligenceJson       Json?
  studioSourceStoryboardId     String?
  studioSourceStoryboardTitle  String?
  studioHandoffVersion         Int?
  studioImportedAt             DateTime?
  /** current | stale | missing — Studio QA freshness vs project images. */
  studioIntelligenceStatus     String?
  /** Last successful Studio metadata refresh (re-sync from storyboard). */
  studioRefreshedAt            DateTime?
  /** Refresh audit events (JSON array). */
  studioRefreshAuditJson       Json?
  /** Short summary when storyboard drift detected (lightweight hint). */
  studioLastStaleReason        String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  images      AnimationImage[]
  transitions AnimationTransition[]
  exports     AnimationExport[]
  languageExports VideoLanguageExport[]
  renderVersions ProjectRenderVersion[]
  fullRerenderDraft ProjectFullRerenderDraft?
  usageLedger AnimationUsageLedger[]

  @@index([ownerId, createdAt])
}

/** In-progress “Nieuwe versie maken” editor state — survives refresh until render or delete. */
model ProjectFullRerenderDraft {
  id        String           @id @default(cuid())
  projectId String           @unique
  project   AnimationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  payload   Json
  updatedAt DateTime         @updatedAt
  createdAt DateTime         @default(now())

  @@index([updatedAt])
}

/** Full Vidu re-render generation — same project images, versioned outputs and snapshots. */
model ProjectRenderVersion {
  id                    String           @id @default(cuid())
  projectId             String
  project               AnimationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  renderVersionNumber   Int
  /** initial | full_rerender */
  kind                  String           @default("initial")
  /** queued | generating | completed | failed */
  status                String           @default("queued")
  /** Reuses project images — no duplicate image rows. */
  sourceImageSetId      String
  createdFromRenderId   String?
  versionNote           String?
  isDefault             Boolean          @default(false)
  promptSnapshot        Json
  storyboardSnapshot    Json
  settingsSnapshot      Json
  segmentSnapshot       Json?
  finalVideoUrl         String?
  cleanVideoUrl         String?
  exportId              String?
  errorMessage          String?
  createdAt             DateTime         @default(now())
  completedAt           DateTime?
  updatedAt             DateTime         @updatedAt

  @@unique([projectId, renderVersionNumber])
  @@index([projectId, createdAt])
  @@index([projectId, isDefault])
}

/** Additional final MP4 per language — text overlay only, no Vidu. */
model VideoLanguageExport {
  id                   String           @id @default(cuid())
  projectId            String
  project              AnimationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  languageCode         String
  languageLabel        String
  outputVideoUrl       String?
  /** queued | rendering | completed | failed | needs_refresh */
  status               String
  sourceFinalVideoUrl  String
  /** Pre-overlay source when available (story overlay re-render). */
  sourceCleanVideoUrl  String?
  /** typography | story_overlay */
  overlayRenderMode    String           @default("typography")
  /** Story Mode overlay copy for this language version (JSON InstantSceneText[]). */
  sceneTextsJson       Json?
  textLayerJson        Json
  translationProvider  String?
  translationAuditJson Json?
  isDefault            Boolean          @default(false)
  version              Int              @default(1)
  versionNote          String?
  errorMessage         String?
  createdAt            DateTime         @default(now())
  completedAt          DateTime?
  updatedAt            DateTime         @updatedAt

  @@unique([projectId, languageCode, version])
  @@index([projectId, createdAt])
}

model AnimationImage {
  id         String           @id @default(cuid())
  projectId  String
  project    AnimationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order      Int
  fileName   String
  mimeType   String?
  sizeBytes  Int?
  storageKey String?
  previewUrl String?
  /** True when user marked uploaded photo as containing fixed baked-in text. */
  hasBakedText Boolean @default(false)
  /** none | detected | confirmed | masked | skipped */
  bakedTextProtectionStatus String @default("none")
  /** User-entered exact copy from the source image (when protected). */
  bakedTextExactCopy String?
  /** Normalized mask rectangle JSON for text band. */
  bakedTextMaskRegion Json?
  /** Detected/confirmed OCR text blocks (JSON BakedTextBlockRecord[]). */
  bakedTextBlocksJson Json?
  /** Text-safe frame URL sent to Vidu instead of previewUrl when protection is active. */
  viduInputUrl String?
  /** High-res PNG text patches for pixel-preserved hybrid overlay (JSON ImageTextPatchesSnapshot). */
  instantTextPatches Json?
  /** Foreground segmentation layers for poster_motion_preserve (JSON PosterMotionLayersSnapshot). */
  posterMotionLayersJson Json?
  /** Studio scene id at last sync (V21 selective sync). */
  studioSceneId String?
  /** Selected Studio scene image id at last sync. */
  studioSceneImageId String?
  createdAt  DateTime         @default(now())

  @@index([projectId, order])
}

model AnimationTransition {
  id            String           @id @default(cuid())
  projectId     String
  project       AnimationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  startImageId  String
  endImageId    String
  order         Int
  status        String
  provider      String?
  providerJobId String?
  outputVideoUrl String?
  errorMessage  String?
  progress      Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([projectId, order])
  @@index([projectId, status])
}

model AnimationExport {
  id            String           @id @default(cuid())
  projectId     String
  project       AnimationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status        String
  /** e.g. external-ffmpeg when merge runs on an external worker */
  provider      String?
  providerJobId String?
  outputVideoUrl String?
  /** Snapshot of locked text layers applied to this export (audit / validation). */
  expectedTextLayers Json?
  errorMessage  String?
  progress      Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([projectId, status])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  /** admin | power | user */
  role         String   @default("user")
  isActive     Boolean  @default(true)
  invitedById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  inviter       User?  @relation("UserInvites", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedUsers  User[] @relation("UserInvites")

  animationProjects AnimationProject[]
  animationUsage    AnimationUsageLedger[]
  invitesCreated    AnimationInvite[] @relation("InviteCreator")
  invitesConsumed   AnimationInvite[] @relation("InviteConsumer")
  instantPremiumPendingOrders InstantPremiumPendingOrder[]
  studioCharacters     StudioCharacter[]
  studioLocations      StudioLocation[]
  studioProps          StudioProp[]
  studioWorldProfiles  StudioWorldProfile[]
  studioStoryboards    StudioStoryboard[]
  studioJobs           StudioJob[]
}

/** Shared visual universe for characters, locations and props (Studio V10). */
model StudioWorldProfile {
  id                 String   @id @default(cuid())
  ownerId            String
  owner              User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name               String
  slug               String
  description        String   @default("")
  visualStyle        String   @default("")
  tone               String   @default("")
  continuityRules    String   @default("")
  /** loose | normal | strong | strict */
  continuityStrength String   @default("strong")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  characters         StudioCharacter[]
  locations          StudioLocation[]
  props              StudioProp[]

  @@unique([ownerId, slug])
  @@index([ownerId, createdAt])
}

/** Reusable character identity for Studio → future Scene Composer → Motion. */
model StudioCharacter {
  id                      String              @id @default(cuid())
  ownerId                 String
  owner                   User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name                    String
  slug                    String
  /** human | mascot | animal | object | other */
  role                    String
  description             String              @default("")
  personality             String              @default("")
  referenceImageUrl       String
  referenceStorageKey     String
  appearanceMemory        String              @default("")
  personalityMemory       String              @default("")
  continuityNotes         String              @default("")
  defaultClothing         String              @default("")
  defaultAccessories      String              @default("")
  visualKeywords          String              @default("")
  primaryReferenceImageId String?
  referenceNotes          String              @default("")
  /** low | normal | strong | strict — how aggressively identity is preserved in prompts */
  identityStrength        String              @default("strong")
  /** loose | normal | strong | strict */
  continuityStrength      String              @default("strong")
  worldProfileId          String?
  worldProfile            StudioWorldProfile? @relation(fields: [worldProfileId], references: [id], onDelete: SetNull)
  isMascot                Boolean             @default(false)
  /** Reserved for globally seeded HomeCheff mascots (Chef, Garden, …). */
  isSystemCharacter       Boolean             @default(false)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  sceneLinks              StudioSceneCharacter[]

  @@unique([ownerId, slug])
  @@index([ownerId, createdAt])
  @@index([worldProfileId])
}

/** Reusable environment / world for Studio → future Scene Composer → Motion. */
model StudioLocation {
  id                  String              @id @default(cuid())
  ownerId             String
  owner               User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name                String
  slug                String
  description         String              @default("")
  /** city | restaurant | garden | market | street | home | office | nature | fantasy | other */
  category            String
  referenceImageUrl   String
  referenceStorageKey String
  worldMemory         String              @default("")
  visualIdentity      String              @default("")
  environmentKeywords String              @default("")
  continuityNotes     String              @default("")
  /** loose | normal | strong | strict */
  continuityStrength  String              @default("strong")
  worldProfileId      String?
  worldProfile        StudioWorldProfile? @relation(fields: [worldProfileId], references: [id], onDelete: SetNull)
  /** Reserved for globally seeded HomeCheff locations (Rotterdam, Community Garden, …). */
  isSystemLocation    Boolean             @default(false)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  scenes              StudioScene[]

  @@unique([ownerId, slug])
  @@index([ownerId, createdAt])
  @@index([worldProfileId])
}

/** Reusable object / prop for Studio → future Scene Composer → Motion. */
model StudioProp {
  id                  String              @id @default(cuid())
  ownerId             String
  owner               User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name                String
  slug                String
  description         String              @default("")
  /** phone | laptop | food | drink | plant | vehicle | furniture | screen | clothing | packaging | tool | brand_asset | other */
  category            String
  referenceImageUrl   String
  referenceStorageKey String
  appearanceMemory    String              @default("")
  brandingRules       String              @default("")
  continuityNotes     String              @default("")
  /** loose | normal | strong | strict */
  continuityStrength  String              @default("strong")
  worldProfileId      String?
  worldProfile        StudioWorldProfile? @relation(fields: [worldProfileId], references: [id], onDelete: SetNull)
  /** Reserved for globally seeded HomeCheff props (Mug, Delivery Bag, …). */
  isSystemProp        Boolean             @default(false)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  sceneLinks          StudioSceneProp[]

  @@unique([ownerId, slug])
  @@index([ownerId, createdAt])
  @@index([worldProfileId])
}

/** Ordered scene sequence for Studio Scene Composer → future Motion. */
model StudioStoryboard {
  id          String        @id @default(cuid())
  ownerId     String
  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  description String        @default("")
  /** commercial | cinematic | children_story | documentary | social_media | corporate */
  promptStyleProfile String @default("commercial")
  /** V23: commercial | documentary | cinematic | social_media | storytelling | educational */
  directorProfile String @default("commercial")
  /** V14: after approved regeneration, auto-select image if combined score improves */
  autoSelectImprovedImage Boolean @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  scenes      StudioScene[]
  jobs        StudioJob[]

  @@index([ownerId])
}

/** Background bulk work for Studio storyboards (V15). */
model StudioJob {
  id           String           @id @default(cuid())
  ownerId      String
  owner        User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  storyboardId String
  storyboard   StudioStoryboard @relation(fields: [storyboardId], references: [id], onDelete: Cascade)
  /** generate_scene_images | analyze_consistency | analyze_vision | improve_weak_scenes */
  type         String
  /** queued | running | completed | failed | cancelled */
  status       String           @default("queued")
  progress     Int              @default(0)
  currentStep  String           @default("")
  totalSteps   Int              @default(0)
  startedAt    DateTime?
  completedAt  DateTime?
  failedAt     DateTime?
  errorMessage String           @default("")
  inputJson    Json
  resultJson   Json?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([ownerId])
  @@index([storyboardId])
  @@index([status])
  @@index([createdAt])
  @@index([storyboardId, status])
}

/** Single composed scene within a storyboard. */
model StudioScene {
  id                   String                 @id @default(cuid())
  storyboardId         String
  storyboard           StudioStoryboard       @relation(fields: [storyboardId], references: [id], onDelete: Cascade)
  order                Int
  title                String                 @default("")
  description          String                 @default("")
  action               String                 @default("")
  emotion              String                 @default("")
  camera               String                 @default("")
  /** V23: extreme_wide | wide | medium | close_up | … */
  shotType             String                 @default("")
  /** V23: static | push_in | pan_left | … */
  cameraMovement       String                 @default("")
  /** V23: calm | neutral | dynamic | intense */
  sceneEnergy          String                 @default("neutral")
  transitionToNext     String                 @default("")
  durationSeconds      Int                    @default(5)
  locationId           String?
  location             StudioLocation?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  /** Preferred image for future Motion import (V8). */
  selectedSceneImageId String?
  selectedSceneImage   StudioSceneImage?      @relation("StudioSceneSelectedImage", fields: [selectedSceneImageId], references: [id], onDelete: SetNull)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  characters           StudioSceneCharacter[]
  props                StudioSceneProp[]
  sceneImages          StudioSceneImage[]     @relation("StudioSceneImages")

  @@unique([storyboardId, order])
  @@index([storyboardId, order])
}

/** AI-generated still for a composed scene (Studio V8). */
model StudioSceneImage {
  id                 String      @id @default(cuid())
  sceneId            String
  scene              StudioScene @relation("StudioSceneImages", fields: [sceneId], references: [id], onDelete: Cascade)
  /** queued | generating | completed | failed */
  status             String
  promptVersion      Int
  generationVersion  Int         @default(1)
  generatedPrompt    String
  imageUrl           String      @default("")
  storageKey         String      @default("")
  thumbnailUrl       String      @default("")
  provider           String
  seed               String?
  generationSettings Json?
  /** V11: prompt-memory consistency analysis (0–100). */
  consistencyScore           Int?
  /** excellent | good | needs_review | poor */
  consistencyStatus          String?
  consistencyReport          Json?
  consistencyRecommendations Json?
  consistencyAnalyzedAt      DateTime?
  /** V12: structured correction recommendations from consistency report */
  correctionRecommendations Json?
  promptPatches               Json?
  /** Prompt sent to image provider when regenerated with corrections */
  correctedPrompt             String   @default("")
  regeneratedFromImageId      String?
  previousConsistencyScore    Int?
  /** Consistency delta after correction regeneration */
  improvementScore            Int?
  previousVisionScore         Int?
  visionImprovementScore      Int?
  /** Average of consistency + vision improvement deltas */
  overallImprovementScore     Int?
  /** V13: visual QA scores from vision provider (0–100). */
  visionScore                   Int?
  /** excellent | good | needs_review | poor */
  visionStatus                  String?
  visionReport                  Json?
  visionAnalyzedAt              DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  selectedByScenes   StudioScene[] @relation("StudioSceneSelectedImage")
  regeneratedFrom    StudioSceneImage?  @relation("StudioSceneImageRegeneration", fields: [regeneratedFromImageId], references: [id], onDelete: SetNull)
  regenerations      StudioSceneImage[] @relation("StudioSceneImageRegeneration")

  @@index([sceneId, createdAt])
  @@index([regeneratedFromImageId])
}

model StudioSceneCharacter {
  sceneId     String
  characterId String
  scene       StudioScene     @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  character   StudioCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([sceneId, characterId])
}

model StudioSceneProp {
  sceneId String
  propId  String
  scene   StudioScene @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  prop    StudioProp  @relation(fields: [propId], references: [id], onDelete: Cascade)

  @@id([sceneId, propId])
}

/** Stripe checkout payload before project creation (paid instant premium). */
model InstantPremiumPendingOrder {
  id                      String   @id @default(cuid())
  ownerId                 String
  owner                   User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  payload                 Json
  stripeCheckoutSessionId String?  @unique
  projectId               String?
  status                  String   @default("pending_payment")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([ownerId, createdAt])
}

model AnimationInvite {
  id              String    @id @default(cuid())
  email           String?
  tokenHash       String    @unique
  /** Role assigned to the user who redeems this invite. */
  role            String    @default("user")
  expiresAt       DateTime
  usedAt          DateTime?
  usedByUserId    String?
  createdByUserId String
  createdAt       DateTime  @default(now())
  revokedAt       DateTime?

  creator User  @relation("InviteCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  usedBy  User? @relation("InviteConsumer", fields: [usedByUserId], references: [id], onDelete: SetNull)

  @@index([createdByUserId])
  @@index([email])
}

model AnimationUsageLedger {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId        String?  @unique
  project          AnimationProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  presetId         String
  estimatedCredits Int
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, presetId, createdAt])
}
