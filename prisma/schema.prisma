generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AnimationProject {
  id          String                @id @default(cuid())
  ownerId     String
  owner       User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String?
  /** Optional bundle label — projects with the same bundleName group together. */
  bundleName  String?
  /** Manual bundle grouping override (preferred over title/bundleName normalization). */
  bundleKey   String?
  /** When set, this row is a draft copy created from another project (safe re-edit path). */
  sourceProjectId String?
  sourceProject   AnimationProject?  @relation("ProjectDraftCopy", fields: [sourceProjectId], references: [id], onDelete: SetNull)
  draftCopies     AnimationProject[] @relation("ProjectDraftCopy")
  /** Language code copied when this draft was created (e.g. nl, en). */
  sourceLanguage String?
  /** Version number copied when this draft was created. */
  sourceVersion  Int?
  /** When the draft copy row was created from a source version. */
  draftCopiedAt  DateTime?
  /** Bundle / rename / version-note audit (JSON BundleAuditEntry[]). */
  bundleAuditJson Json?
  status      String
  /** classic (default) | instant_premium */
  projectType String                @default("classic")
  /** Target merged length for instant_premium; derived from image count × transition seconds. */
  instantOutputDurationSeconds Int?
  /** Story Mode: sum of all scene card durations (overlay pacing plan); may exceed instantOutputDurationSeconds. */
  instantStoryboardDurationSeconds Int?
  /** transition = pairwise Vidu segments; story = single Vidu multiframe video. */
  instantMode String @default("transition")
  /** Per-transition / per-multiframe-segment duration: 3, 5, or 8 (UI: Fast / Standard / Cinematic). */
  instantTransitionSeconds Int @default(5)
  /** Story mode scene copy for post-Vidu ASS overlay (JSON InstantSceneText[]). */
  instantSceneTexts Json?
  /** string[] chip ids for instant_premium */
  instantSelectedChips Json?
  instantUserIntent   String?
  /** Locked overlay text layers (JSON LockedTextLayer[]). Rendered after Vidu, not by the model. */
  instantLockedTextLayers Json?
  /** Canonical language-export layers (JSON LanguageTextLayersSnapshot). */
  languageTextLayersJson Json?
  /** When true, Vidu prompts include text-safety rules and finals get deterministic text overlays. */
  instantLockedTextMode Boolean @default(true)
  /** poster_motion_preserve | deevid_text_safe | hybrid_overlay | exact_freeze | none */
  instantTextRenderMode String @default("poster_motion_preserve")
  /** DeeVid poster animation toggles (JSON PosterMotionSettings). */
  instantPosterMotionSettings Json?
  /** exact | cinematic | social-ui | floating | soft-glow | kinetic */
  instantHybridOverlayStyle String @default("cinematic")
  /** OCR-enriched text blocks for hybrid reprojection (JSON ProjectDetectedTextSnapshot). */
  instantDetectedTextMetadata Json?
  /** Last sanitized overlay error (e.g. missing drawtext); safe for UI. */
  lastOverlayError String?
  /** overlay_failed | merge_failed when status is failed_overlay or failed */
  failureReason String?
  /** Worker job tracking when VIDEO_RENDER_MODE=worker */
  instantWorkerJobStartedAt DateTime?
  /** queued | running | completed | failed */
  instantWorkerJobStatus String?
  /** Incremented after each successful final-video rebuild (merge-only). */
  instantFinalRebuildCount Int @default(0)
  instantFinalRebuiltAt DateTime?
  /** Last successful final URL before the most recent rebuild. */
  instantPreviousFinalVideoUrl String?
  /** Optional notes per text rerender generation (JSON TextVersionNoteEntry[]). */
  instantTextVersionNotesJson Json?
  /** Pre-overlay merged Vidu video (concat only, no ASS/locked text). */
  instantCleanFinalVideoUrl String?
  /** running | failed — null when idle */
  instantFinalRebuildStatus String?
  /** Non-billable rebuild audit events (JSON). */
  instantFinalRebuildAuditJson Json?
  stylePreset String?
  aspectRatio String?
  /** basic | standard | pro | smooth — enforced server-side */
  presetId             String   @default("standard")
  /** Vidu model id used for transitions (from preset at create time). */
  viduModel            String?
  viduResolution       String?
  viduDurationSeconds  Int?
  /** Estimated credits for this project at creation (UI / planning only). */
  estimatedCredits     Int?
  /** True when admin (or future power) used advanced overrides vs preset-only Vidu fields. */
  advancedSettingsEnabled Boolean @default(false)
  /** Optional user hint; combined server-side with preset prompt for Vidu. */
  userPrompt           String?
  /** morph | cinematic | product | dynamic — guides combined prompt; defaults to cinematic when null. */
  intent               String?
  /** Shared continuity framing for every transition; null on legacy rows uses server default. */
  globalPromptContext  String?
  /** Sanitized Studio → Motion handoff payload (metadata only, no binaries). */
  studioHandoffJson            Json?
  /** Studio QA intelligence snapshot + image lineage fingerprint. */
  studioIntelligenceJson       Json?
  studioSourceStoryboardId     String?
  studioSourceStoryboardTitle  String?
  studioHandoffVersion         Int?
  studioImportedAt             DateTime?
  /** current | stale | missing — Studio QA freshness vs project images. */
  studioIntelligenceStatus     String?
  /** Last successful Studio metadata refresh (re-sync from storyboard). */
  studioRefreshedAt            DateTime?
  /** Refresh audit events (JSON array). */
  studioRefreshAuditJson       Json?
  /** Short summary when storyboard drift detected (lightweight hint). */
  studioLastStaleReason        String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  images      AnimationImage[]
  transitions AnimationTransition[]
  exports     AnimationExport[]
  languageExports VideoLanguageExport[]
  renderVersions ProjectRenderVersion[]
  fullRerenderDraft ProjectFullRerenderDraft?
  usageLedger AnimationUsageLedger[]
  providerUsageLogs ProviderUsageLog[]
  providerCostEvents ProviderCostEvent[]
  customerBillingEvents CustomerBillingEvent[]

  @@index([ownerId, createdAt])
  @@index([sourceProjectId])
  @@index([ownerId, bundleKey])
  @@index([ownerId, bundleName])
}

/** In-progress “Nieuwe versie maken” editor state — survives refresh until render or delete. */
model ProjectFullRerenderDraft {
  id        String           @id @default(cuid())
  projectId String           @unique
  project   AnimationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  payload   Json
  updatedAt DateTime         @updatedAt
  createdAt DateTime         @default(now())

  @@index([updatedAt])
}

/** Full Vidu re-render generation — same project images, versioned outputs and snapshots. */
model ProjectRenderVersion {
  id                    String           @id @default(cuid())
  projectId             String
  project               AnimationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  renderVersionNumber   Int
  /** initial | full_rerender */
  kind                  String           @default("initial")
  /** queued | generating | completed | failed */
  status                String           @default("queued")
  /** Reuses project images — no duplicate image rows. */
  sourceImageSetId      String
  createdFromRenderId   String?
  versionNote           String?
  isDefault             Boolean          @default(false)
  promptSnapshot        Json
  storyboardSnapshot    Json
  settingsSnapshot      Json
  segmentSnapshot       Json?
  finalVideoUrl         String?
  cleanVideoUrl         String?
  exportId              String?
  errorMessage          String?
  createdAt             DateTime         @default(now())
  completedAt           DateTime?
  updatedAt             DateTime         @updatedAt

  @@unique([projectId, renderVersionNumber])
  @@index([projectId, createdAt])
  @@index([projectId, isDefault])
}

/** Additional final MP4 per language — text overlay only, no Vidu. */
model VideoLanguageExport {
  id                   String           @id @default(cuid())
  projectId            String
  project              AnimationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  languageCode         String
  languageLabel        String
  outputVideoUrl       String?
  /** queued | rendering | completed | failed | needs_refresh */
  status               String
  sourceFinalVideoUrl  String
  /** Pre-overlay source when available (story overlay re-render). */
  sourceCleanVideoUrl  String?
  /** typography | story_overlay */
  overlayRenderMode    String           @default("typography")
  /** Story Mode overlay copy for this language version (JSON InstantSceneText[]). */
  sceneTextsJson       Json?
  textLayerJson        Json
  translationProvider  String?
  translationAuditJson Json?
  isDefault            Boolean          @default(false)
  version              Int              @default(1)
  versionNote          String?
  errorMessage         String?
  createdAt            DateTime         @default(now())
  completedAt          DateTime?
  updatedAt            DateTime         @updatedAt

  @@unique([projectId, languageCode, version])
  @@index([projectId, createdAt])
}

model AnimationImage {
  id         String           @id @default(cuid())
  projectId  String
  project    AnimationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order      Int
  fileName   String
  mimeType   String?
  sizeBytes  Int?
  storageKey String?
  previewUrl String?
  /** True when user marked uploaded photo as containing fixed baked-in text. */
  hasBakedText Boolean @default(false)
  /** none | detected | confirmed | masked | skipped */
  bakedTextProtectionStatus String @default("none")
  /** User-entered exact copy from the source image (when protected). */
  bakedTextExactCopy String?
  /** Normalized mask rectangle JSON for text band. */
  bakedTextMaskRegion Json?
  /** Detected/confirmed OCR text blocks (JSON BakedTextBlockRecord[]). */
  bakedTextBlocksJson Json?
  /** Text-safe frame URL sent to Vidu instead of previewUrl when protection is active. */
  viduInputUrl String?
  /** High-res PNG text patches for pixel-preserved hybrid overlay (JSON ImageTextPatchesSnapshot). */
  instantTextPatches Json?
  /** Foreground segmentation layers for poster_motion_preserve (JSON PosterMotionLayersSnapshot). */
  posterMotionLayersJson Json?
  /** Studio scene id at last sync (V21 selective sync). */
  studioSceneId String?
  /** Selected Studio scene image id at last sync. */
  studioSceneImageId String?
  createdAt  DateTime         @default(now())

  @@index([projectId, order])
}

model AnimationTransition {
  id            String           @id @default(cuid())
  projectId     String
  project       AnimationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  startImageId  String
  endImageId    String
  order         Int
  status        String
  provider      String?
  providerJobId String?
  outputVideoUrl String?
  errorMessage  String?
  progress      Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([projectId, order])
  @@index([projectId, status])
}

model AnimationExport {
  id            String           @id @default(cuid())
  projectId     String
  project       AnimationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status        String
  /** e.g. external-ffmpeg when merge runs on an external worker */
  provider      String?
  providerJobId String?
  outputVideoUrl String?
  /** Snapshot of locked text layers applied to this export (audit / validation). */
  expectedTextLayers Json?
  errorMessage  String?
  progress      Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([projectId, status])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  /** admin | power | user */
  role         String   @default("user")
  isActive     Boolean  @default(true)
  invitedById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  inviter       User?  @relation("UserInvites", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedUsers  User[] @relation("UserInvites")

  animationProjects AnimationProject[]
  animationUsage    AnimationUsageLedger[]
  providerUsageLogs ProviderUsageLog[]
  providerCostEvents ProviderCostEvent[]
  customerBillingEvents CustomerBillingEvent[]
  invitesCreated    AnimationInvite[] @relation("InviteCreator")
  invitesConsumed   AnimationInvite[] @relation("InviteConsumer")
  instantPremiumPendingOrders InstantPremiumPendingOrder[]
  studioCharacters     StudioCharacter[]
  studioLocations      StudioLocation[]
  studioProps          StudioProp[]
  studioWorldProfiles  StudioWorldProfile[]
  studioStoryboards    StudioStoryboard[]
  studioJobs           StudioJob[]
  studioGenerationJobs StudioGenerationJob[]
  editorCanvasProjects EditorCanvasProject[]
  homeCheffProjects    HomeCheffProject[]
  studioAccount        StudioAccount?
  studioWallet         StudioWallet?
  studioLedgerEntries  StudioLedgerEntry[]
  studioAutoTopUpAttempts StudioAutoTopUpAttempt[]
  studioShowcaseItemsCreated StudioShowcaseItem[] @relation("ShowcaseItemCreator")
  /** S.5 canonical project + library */
  studioCreativeProjects StudioCreativeProject[]
  studioLibraryAssets    StudioLibraryAsset[]
  studioAssetCollections StudioAssetCollection[]
  studioFavorites        StudioFavorite[]
  studioBrandKits        StudioBrandKit[]
  studioPromptPresets    StudioPromptPreset[]
}

/** HomeCheff Studio account — plan, billing, credit policy (1:1 with User). */
model StudioAccount {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /** free | creator | pro | studio | enterprise */
  accountType           String    @default("free")
  /** Plan SKU id from studio-plan-config */
  studioPlan            String    @default("free")
  planVersion           String    @default("v1")
  creditPolicyVersion   String    @default("v1")
  /** active | suspended | closed */
  accountStatus         String    @default("active")
  /** none | active | past_due | canceled | prepaid */
  billingStatus         String    @default("none")
  activatedAt           DateTime?
  autoChargeSmallActions Boolean  @default(true)
  confirmAboveCredits   Int       @default(100)
  /** S.8B Auto Top-Up — explicit opt-in; never silent */
  autoTopUpEnabled      Boolean   @default(false)
  autoTopUpThresholdCredits Int   @default(50)
  autoTopUpPackSlug     String    @default("pack_500")
  autoTopUpConsentAt    DateTime?
  autoTopUpStatus       String    @default("disabled")
  autoTopUpLastAttemptAt DateTime?
  autoTopUpLastSuccessAt DateTime?
  autoTopUpFailureCount Int       @default(0)
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  stripePriceId         String?
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([accountType])
  @@index([billingStatus])
  @@index([stripeCustomerId])
}

/** Single Studio credit wallet per user. */
model StudioWallet {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance            Int       @default(0)
  purchasedBalance   Int       @default(0)
  promotionalBalance Int       @default(0)
  reservedBalance    Int       @default(0)
  lifetimePurchased  Int       @default(0)
  lifetimeGranted    Int       @default(0)
  lifetimeSpent      Int       @default(0)
  lifetimeRefunded   Int       @default(0)
  lastTransactionAt  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

/** Immutable ledger — every wallet mutation goes through here. */
model StudioLedgerEntry {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId        String?
  service          String
  /** credit_purchase | subscription_grant | admin_grant | usage_charge | usage_reservation | usage_capture | usage_refund | failed_generation_refund | bonus_grant | expiration_adjustment | manual_adjustment | promotional_grant */
  actionType       String
  creditsDelta     Int
  balanceAfter     Int
  /** PURCHASED | PROMOTIONAL | BETA | COMPENSATION | REFERRAL | MANUAL_GRANT */
  creditOrigin     String?
  provider         String?
  providerCostUsd  Float?
  reservedCostUsd  Float?
  marginEstimate   Float?
  metadataJson     Json     @default("{}")
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, projectId])
  @@index([actionType])
  @@index([service])
  @@index([creditOrigin])
}

/** S.8B — Idempotent Auto Top-Up attempts (one Stripe charge per key). */
model StudioAutoTopUpAttempt {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  idempotencyKey       String
  packSlug             String
  status               String   @default("pending")
  /** pending | succeeded | failed | duplicate_prevented | payment_auth_required | payment_method_required */
  stripePaymentIntentId String?
  stripeCheckoutSessionId String?
  creditsGranted       Int      @default(0)
  ledgerEntryId        String?
  failureCode          String?
  financialCorrelationId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([stripePaymentIntentId])
  @@index([stripeCheckoutSessionId])
}

/** Singleton billing policy — carry mode, defaults, plan benefits JSON. */
model StudioBillingPolicy {
  id                         String   @id @default("default")
  carryMode                  String   @default("UNLIMITED")
  newUserGrantCredits        Int      @default(0)
  newUserPromotionCredits    Int      @default(0)
  betaLaunchCredits          Int      @default(0)
  /** 0 = unlimited new-user campaign slots */
  newUserCampaignMaxUsers    Int      @default(0)
  newUserCampaignRedeemed    Int      @default(0)
  defaultConfirmAboveCredits Int      @default(100)
  plansJson                  Json     @default("{}")
  updatedAt                  DateTime @updatedAt
}

/** Admin-managed subscription plans — DB is source of truth; TS config is fallback. */
model StudioSubscriptionPlan {
  id                   String   @id @default(cuid())
  slug                 String   @unique
  name                 String
  description          String   @default("")
  monthlyPriceEur      Float?
  yearlyPriceEur       Float?
  discountPercent      Int      @default(0)
  storageLimitGb       Int?
  featureFlags         Json     @default("[]")
  autoTopUpAvailable   Boolean  @default(false)
  isVisible            Boolean  @default(true)
  isActive             Boolean  @default(true)
  displayOrder         Int      @default(0)
  stripePriceIdMonthly String?
  stripePriceIdYearly  String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([isActive, isVisible, displayOrder])
}

/** Admin-managed credit packs — DB is source of truth; TS config is fallback. */
model StudioCreditPack {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  credits       Int
  priceEur      Float
  bonusCredits  Int      @default(0)
  active        Boolean  @default(true)
  displayOrder  Int      @default(0)
  stripePriceId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([active, displayOrder])
}

/** Admin-managed promotional credit campaigns. */
model StudioPromotion {
  id                        String                      @id @default(cuid())
  name                      String
  slug                      String                      @unique
  active                    Boolean                     @default(true)
  /** Internal admin notes — not shown to customers */
  descriptionInternal       String                      @default("")
  /** Legacy bonus credits field — still used for bonus_credits benefit type */
  creditAmount              Int                         @default(0)
  maximumUsers              Int                         @default(0)
  /** bonus_credits | percentage_discount | fixed_discount | subscription_discount | credit_pack_bonus | free_trial_credits */
  benefitType               String                      @default("bonus_credits")
  percentageDiscount        Float?
  fixedDiscountEur          Float?
  subscriptionDiscountPercent Float?
  creditPackBonusPercent    Float?
  freeTrialCredits          Int?
  /** once | repeating | forever — Stripe coupon duration for discount types */
  discountDuration          String                      @default("once")
  discountDurationMonths    Int?
  /** JSON array of plan slugs (creator, pro, studio) — empty = all plans */
  allowedPlanSlugs          Json                        @default("[]")
  appliesToMonthly          Boolean                     @default(true)
  appliesToYearly           Boolean                     @default(true)
  /** registration | first_payment | manual — when bonus credits are granted */
  bonusCreditsApplyWhen     String                      @default("first_payment")
  bonusCreditsExpireDays    Int?
  newUserOnly               Boolean                     @default(false)
  specificPlanSlug          String?
  maxRedemptions            Int?
  maxRedemptionsPerUser     Int                         @default(1)
  /** PROMOTIONAL | BETA | COMPENSATION | REFERRAL */
  grantType                 String                      @default("PROMOTIONAL")
  startDate                 DateTime?
  endDate                   DateTime?
  /** Stripe Coupon ID for discount benefit types */
  stripeCouponId            String?
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  redemptions               StudioPromotionRedemption[]
  promoCodes                StudioPromoCode[]

  @@index([active, startDate, endDate])
  @@index([stripeCouponId])
}

model StudioPromotionRedemption {
  id             String          @id @default(cuid())
  promotionId    String
  promotion      StudioPromotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  userId         String
  creditsGranted Int
  ledgerEntryId  String?
  promoCodeId    String?
  createdAt      DateTime        @default(now())

  @@unique([promotionId, userId])
  @@index([userId, createdAt])
}

/** Promo codes linked to promotions — synced to Stripe Promotion Codes for discounts. */
model StudioPromoCode {
  id                     String                    @id @default(cuid())
  code                   String                    @unique
  promotionId            String
  promotion              StudioPromotion           @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  active                 Boolean                   @default(true)
  maxUses                Int?
  usedCount              Int                       @default(0)
  startDate              DateTime?
  endDate                DateTime?
  notes                  String                    @default("")
  stripePromotionCodeId  String?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  redemptions            StudioPromoCodeRedemption[]

  @@index([promotionId, active])
  @@index([stripePromotionCodeId])
}

model StudioPromoCodeRedemption {
  id          String          @id @default(cuid())
  promoCodeId String
  promoCode   StudioPromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  promotionId String
  userId      String
  appliedAt   DateTime        @default(now())
  metadataJson Json           @default("{}")

  @@unique([promoCodeId, userId])
  @@index([userId, appliedAt])
}

/** Database-driven action pricing — overrides studio-action-cost-registry when active. */
model StudioPricingRule {
  id                       String   @id @default(cuid())
  actionType               String   @unique
  creditCost               Int
  providerCostUsd          Float
  active                   Boolean  @default(true)
  notes                    String   @default("")
  category                 String?
  displayNameNl            String?
  displayNameEn            String?
  descriptionNl            String?
  descriptionEn            String?
  visibleInCatalog         Boolean  @default(true)
  sortOrder                Int      @default(0)
  provider                 String?
  marginWarningThreshold     Float    @default(0)
  updatedByUserId          String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@index([active])
  @@index([category, sortOrder])
  @@index([visibleInCatalog, active])
}

/** Universal HomeCheff .hc master project container. */
model HomeCheffProject {
  id                    String    @id @default(cuid())
  ownerId               String
  owner                 User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title                 String
  description           String    @default("")
  packageVersion        Int       @default(1)
  projectFormat         String    @default("hc")
  projectVersionLabel   String    @default("1")
  manifestJson          Json
  servicePayloadJson    Json      @default("{}")
  currentService        String?
  sourceService         String?
  legacySourceJson      Json?
  isArchived            Boolean   @default(false)
  archivedAt            DateTime?
  conversionHistoryJson Json      @default("[]")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  handoffs  ProjectHandoff[]
  assetRefs ProjectAssetReference[]

  @@index([ownerId, updatedAt])
  @@index([ownerId, projectFormat, isArchived])
}

model ProjectHandoff {
  id              String   @id @default(cuid())
  sourceProjectId  String
  sourceProject    HomeCheffProject @relation(fields: [sourceProjectId], references: [id], onDelete: Cascade)
  sourceType       String
  targetProjectId  String?
  targetType       String
  handoffType      String
  payloadJson      Json     @default("{}")
  createdAt        DateTime @default(now())

  @@index([sourceProjectId])
}

model ProjectAssetReference {
  id              String   @id @default(cuid())
  packageId        String
  package          HomeCheffProject @relation(fields: [packageId], references: [id], onDelete: Cascade)
  assetId          String
  url             String
  storageKey       String?
  kind            String
  role            String?
  permissionsJson  Json     @default("{}")
  createdAt        DateTime @default(now())

  @@index([packageId])
  @@index([packageId, assetId])
}

/** Persisted HomeCheff Editor canvas project (compositor state, layers, handoff). */
model EditorCanvasProject {
  id         String    @id
  ownerId    String
  owner      User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name       String
  status     String    @default("active")
  payload    Json
  updatedAt  DateTime  @updatedAt
  createdAt  DateTime  @default(now())
  archivedAt DateTime?

  @@index([ownerId, status, updatedAt])
}

/** Shared visual universe for characters, locations and props (Studio V10). */
model StudioWorldProfile {
  id                 String   @id @default(cuid())
  ownerId            String
  owner              User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name               String
  slug               String
  description        String   @default("")
  visualStyle        String   @default("")
  tone               String   @default("")
  continuityRules    String   @default("")
  /** loose | normal | strong | strict */
  continuityStrength String   @default("strong")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  characters         StudioCharacter[]
  locations          StudioLocation[]
  props              StudioProp[]

  @@unique([ownerId, slug])
