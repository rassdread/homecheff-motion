DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Run once per database (e.g. after first deploy): npx prisma migrate deploy

# --- Instant Premium (Stripe Checkout, EUR) ---
# INSTANT_PREMIUM_MODE=test
# Use `paid` to enable Stripe checkout flow.
# STRIPE_SECRET_KEY=sk_test_...
# Optional: Stripe webhook for server-side fulfillment (success page also calls /complete).
# STRIPE_WEBHOOK_SECRET=whsec_...

# Session cookies (use a long random string in production).
# AUTH_SECRET=
#
# Cookie "Secure" flag (production):
# - COOKIE_SECURE=true / false — explicit override.
# - If unset: VERCEL=1 → Secure on; OR any of NEXT_PUBLIC_APP_URL / NEXT_PUBLIC_VERCEL_URL /
#   PUBLIC_BASE_URL starts with https:// → Secure on (custom HTTPS hosts like motion.*).
# - Otherwise Secure off (e.g. `next start` on http://localhost) — set COOKIE_SECURE=false for that.
#
# If login returns 200 but you stay logged out on HTTPS, set COOKIE_SECURE=true (or set
# NEXT_PUBLIC_APP_URL=https://your-domain).
# COOKIE_SECURE=true
# COOKIE_SECURE=false
#
# Optional public site URL (also used to infer Secure cookies when https):
# NEXT_PUBLIC_APP_URL=https://motion.example.com

# Image uploads (Vercel Blob). Dashboard: Project → Storage → Blob → create store,
# then link the store to this project so the env var appears, or paste Read-Write token.
# Wrong/missing token → "No token found" or "This store does not exist".
# BLOB_READ_WRITE_TOKEN=

# Quality tiers (basic / standard / pro) are enforced on the server; clients only send presetId.
# --- Animation video provider (server-only; never NEXT_PUBLIC_*) ---
# mock (default) | vidu
# ANIMATION_PROVIDER=mock
#
# Real Vidu (image start/end → video). Requires publicly reachable HTTPS image URLs
# (e.g. Vercel Blob). Localhost preview URLs will fail unless you set PUBLIC_BASE_URL
# to a tunnel or deploy to Vercel (VERCEL_URL).
#
# ANIMATION_PROVIDER=vidu
# VIDU_API_KEY=
# VIDU_ENABLE_REAL_CALLS=true
#
# Optional:
# VIDU_BASE_URL=https://api.vidu.com
# VIDU_MODEL=viduq3-turbo
# VIDU_RESOLUTION=720p
# VIDU_DURATION_SECONDS=5
# PUBLIC_BASE_URL=https://your-deployment.example.com
# VIDU_DEBUG=true
#
# --- Animation export / FFmpeg merge ---
# Vercel does not reliably provide FFmpeg; production should use an external merge worker.
# Local mode runs FFmpeg on the Next.js host (development / manual testing only).
#
# ANIMATION_EXPORT_MODE=local | external
# Default: local in development; in production, external if EXTERNAL_MERGE_API_URL is set, else local.
# ANIMATION_EXPORT_MODE=external
# EXTERNAL_MERGE_API_URL=https://your-merge-worker.example.com
# EXTERNAL_MERGE_API_KEY=shared-secret-for-worker-auth
#
# Same random secret on Vercel and the Railway merge worker. Worker sends it as header
# `x-motion-worker-secret` when POSTing merge results to the app callback route.
# MOTION_WORKER_SECRET=
#
# Reference worker (see worker/ffmpeg-merge-worker/README.md):
# MERGE_WORKER_API_KEY=
# WORKER_PUBLIC_URL=http://localhost:8787
# FFmpeg (merge + locked text overlay). Production MUST have drawtext (libfreetype).
# Linux/Docker/Railway example:
#   FFMPEG_PATH=/usr/bin/ffmpeg
#   FFMPEG_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
# Install: ffmpeg with freetype + fonts-dejavu-core (or equivalent), then verify:
#   ffmpeg -filters 2>&1 | grep drawtext
# macOS (Homebrew default ffmpeg lacks drawtext):
#   brew install ffmpeg-full
#   FFMPEG_PATH=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
#   FFMPEG_FONT_PATH=/System/Library/Fonts/Supplemental/Arial Bold.ttf
# Health check: GET /api/health/video
# FFMPEG_PATH=
# FFPROBE_PATH=
# FFMPEG_FONT_PATH=
# On Vercel (VIDEO_RENDER_MODE=worker): app does not run FFmpeg; worker uses static binaries or these paths.
#
# Video rendering architecture:
# VIDEO_RENDER_MODE=local   — merge/overlay on this process (local dev)
# VIDEO_RENDER_MODE=worker  — Vercel delegates FFmpeg to Railway worker (production)
# VIDEO_WORKER_BASE_URL=https://your-video-worker.up.railway.app
# VIDEO_WORKER_SECRET=shared-random-secret
#
# Optional: show language-export / playback debug panels in the UI (default off).
# NEXT_PUBLIC_ENABLE_DEBUG_UI=true
#
# Test/dev only: allow Instant Premium with locked text when FFmpeg drawtext is missing.
# ALLOW_UNSAFE_VIDEO_RENDERING=true
#
# Baked-in text OCR (Instant Premium step 2 — server-side only):
# GOOGLE_VISION_API_KEY=   — preferred
# OPENAI_API_KEY=          — OCR fallback + Instant Premium preflight (vision JSON, server-only)
# OPENAI_VISION_MODEL=gpt-4o-mini
# OPENAI_PREFLIGHT_MODEL=gpt-4o-mini
# Auto-confirm baked text when all OCR blocks are >= 80% confidence (server-side).
# AUTO_CONFIRM_BAKED_TEXT=true
#
# Optional: after final export completes, delete transition `outputVideoUrl` blobs that look like
# Vercel Blob URLs (skips external Vidu URLs). Keeps final video + image assets.
# ANIMATION_DELETE_TRANSITION_BLOBS_AFTER_FINAL=true
#
# Debug: bypass compositor, seamless joins, text overlay, and xfade — plain canonical concat only.
# FINAL_ASSEMBLY_SAFE_MODE=plain_concat
#
# Local vision for export-time safe zones (required on video worker in production; optional locally):
# HC_ENABLE_MEDIAPIPE_SAFE_ZONES=1
# HC_ENABLE_OBJECT_SAFE_ZONES=1
# HC_OBJECT_DETECTOR_KIND=rtdetr
# HC_OBJECT_DETECTOR_MODEL_DIR=/app/models/object-detector
# Production worker: Dockerfile.worker sets these + downloads RT-DETR at build.
# Render native (no Docker): use build command `npm ci && npm run build:worker`; leave MODEL_DIR unset (defaults to repo/models/object-detector).
# HC_OBJECT_DETECTOR_MODEL_PATH=
# HC_SAFE_ZONE_DEBUG=1
# One-time on the video worker (RT-DETR ONNX, Apache 2.0):
#   npm run setup:vision-models -- --include-object-detector
#   npm run setup:vision-models -- --include-object-detector --kind=rtdetr
# Admin readiness: GET /api/admin/video/vision-health?probe=1
